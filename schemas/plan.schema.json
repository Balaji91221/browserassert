{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "checks"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "timeoutMs": {
      "type": "number",
      "minimum": 1,
      "maximum": 60000
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": [
          "selector",
          "expected",
          "id"
        ],
        "properties": {
          "selector": {
            "type": "string",
            "minLength": 1
          },
          "expected": {
            "type": [
              "string",
              "number",
              "boolean",
              "null"
            ]
          },
          "reload": {
            "type": "boolean"
          },
          "operator": {
            "enum": [
              "equals",
              "contains",
              "at_least",
              "at_most"
            ]
          },
          "timeoutMs": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 60000
          },
          "pollMs": {
            "type": "number",
            "minimum": 1
          },
          "id": {
            "type": "string",
            "minLength": 1
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "operator": {
                  "const": "contains"
                }
              },
              "required": [
                "operator"
              ]
            },
            "then": {
              "properties": {
                "expected": {
                  "type": "string"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "operator": {
                  "enum": [
                    "at_least",
                    "at_most"
                  ]
                }
              },
              "required": [
                "operator"
              ]
            },
            "then": {
              "properties": {
                "expected": {
                  "type": "number"
                }
              }
            }
          }
        ]
      }
    },
    "authenticated": {
      "allOf": [
        {
          "type": "object",
          "required": [
            "selector",
            "expected"
          ],
          "properties": {
            "selector": {
              "type": "string",
              "minLength": 1
            },
            "expected": {
              "type": [
                "string",
                "number",
                "boolean",
                "null"
              ]
            },
            "reload": {
              "type": "boolean"
            },
            "operator": {
              "enum": [
                "equals",
                "contains",
                "at_least",
                "at_most"
              ]
            },
            "timeoutMs": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 60000
            },
            "pollMs": {
              "type": "number",
              "minimum": 1
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "operator": {
                    "const": "contains"
                  }
                },
                "required": [
                  "operator"
                ]
              },
              "then": {
                "properties": {
                  "expected": {
                    "type": "string"
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "operator": {
                    "enum": [
                      "at_least",
                      "at_most"
                    ]
                  }
                },
                "required": [
                  "operator"
                ]
              },
              "then": {
                "properties": {
                  "expected": {
                    "type": "number"
                  }
                }
              }
            }
          ]
        },
        {
          "properties": {
            "reload": {
              "const": false
            }
          }
        }
      ]
    }
  }
}
