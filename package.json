{
  "name": "@ai-opensource-local/browserassert",
  "version": "0.2.0",
  "private": true,
  "description": "Evidence based postcondition checks for browser actions",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schemas/*": "./schemas/*"
  },
  "bin": {
    "browserassert": "./dist/cli.js"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "demo": "node src/cli.ts demo",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "start": "node dist/cli.js"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "playwright": "^1.64.0",
    "typescript": "^5.9.3"
  },
  "files": [
    "dist",
    "README.md",
    "IMPLEMENTATION_STATUS.md",
    "examples",
    "LICENSE",
    "FEATURE_MATRIX.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "docs",
    "schemas"
  ],
  "types": "./dist/index.d.ts",
  "license": "MIT"
}
